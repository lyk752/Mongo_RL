  "mongo_reward_extensions": {
    "stand_still_wheel_vel": "Actual wheel-speed squared excess over 0.3 rad/s, sum over both wheels; enabled only when raw vx, vy and yaw commands are all exactly zero. Default weight -0.10 (5 times the former -0.02), multiplied by step_dt. Independent of the tracking-command deadzone.",
    "virtual_leg_pitch_rate": "Sum over two legs of squared rate excess above 0.1 rad/s, normalized by 1 rad/s, weight -0.1 times dt and velocity-command-only steady gate. Body-relative wheel geometry, wrapped position difference per control step; no PhysX joint velocity feedback. Reset-first derivative zero.",
    "stand_still_body_lin_vel": "Strict raw vx/vy zero, including nonzero yaw commands; normalized planar body speed squared (scale 0.1 m/s), weight -0.5 times dt. Transition scale 0.25 + 0.75 * velocity-command steady gate; no actual-speed tolerance or clipping.",
    "stand_still_body_ang_vel": "Strict raw vx/vy/yaw all-zero gate; squared body yaw rate normalized by 0.2 rad/s, weight -0.1 times dt; transition scale 0.25 + 0.75 * velocity-command steady gate.",
    "orientation_full_weight": "All six pitch/roll terms use full weights in every command phase, without steady-gate scaling.",
    "front_wheel_impact": "Squared peak resultant force excess above 50 N, normalized by 100 N; weight -1 times step_dt, all command phases. Physics contact history length 4 at 0.005 s covers one 0.02 s control period; light contact allowed. No force clipping or new contact termination.",
    "stand_still_position": "Strict raw vx/vy/yaw zero continuously for 0.6 s, then capture fixed world XY anchor and smoothstep in over 0.4 s. Squared radial displacement excess over 0.01 m, normalized by 0.05 m, weight -0.5 times dt. Clear on any nonzero command or per-environment reset; no reanchor from measured motion, height or arm changes. Reward only; observations unchanged.",
    "linear_velocity_tracking_priority": "track_lin_vel_xy weight raised from reference 1.0 to 1.5; original formula unchanged."
  },
